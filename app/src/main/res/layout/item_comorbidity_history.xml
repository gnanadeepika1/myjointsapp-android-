<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    card_view:cardCornerRadius="10dp"
    card_view:cardElevation="4dp"
    card_view:cardUseCompatPadding="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Main container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="#E7F5FF">

        <!-- LEFT CONTENT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Comorbidity icon -->
                <ImageView
                    android:id="@+id/ic_comorb"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_comorbidity"
                    android:contentDescription="Comorbidity Icon" />

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Comorbidity"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#F5A1D9" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tvText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="This is a Comorbidity"
                android:textSize="16sp"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- RIGHT: Delete button -->
        <ImageView
            android:id="@+id/btnDeleteComorbidity"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_delete_account"
            android:padding="8dp"
            android:layout_gravity="center_vertical"
            android:tint="#000000"
            android:contentDescription="Delete Comorbidity" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
