<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    card_view:cardCornerRadius="10dp"
    card_view:cardElevation="4dp"
    card_view:cardUseCompatPadding="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Main horizontal container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="#E7F5FF">

        <!-- LEFT CONTENT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/icReferral"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:tint="#F06292"/>

                <TextView
                    android:id="@+id/tvReferralTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Referral Details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#F48FB1"/>
            </LinearLayout>

            <!-- Referral message -->
            <TextView
                android:id="@+id/tvReferralMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:background="#F8DFF4"
                android:text="Referral text goes here"
                android:textColor="#000000"
                android:textSize="16sp"/>

            <!-- Patient ID -->
            <TextView
                android:id="@+id/tvReferralPatientId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Patient ID: -----"
                android:textSize="14sp"
                android:textColor="#555555"/>
        </LinearLayout>

        <!-- RIGHT: Delete button -->
        <ImageView
            android:id="@+id/btnDeleteReferral"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_delete_account"
            android:padding="8dp"
            android:layout_gravity="center_vertical"
            android:tint="#000000"
            android:contentDescription="Delete Referral"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>
